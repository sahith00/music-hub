# Postgres connection string (use SSL params required by your host, e.g. ?sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# API port (Vite proxies /api here in dev)
PORT=4000

# Comma-separated browser origins allowed to call the API (required in production if the SPA is on another host)
# CORS_ORIGIN=https://your-app.example.com

# Schema: after npm install in this folder, pick one:
#   npm run db:migrate   # applies ./drizzle SQL (good for prod)
#   npm run db:push      # syncs src/db/schema.ts (quick for local dev)
